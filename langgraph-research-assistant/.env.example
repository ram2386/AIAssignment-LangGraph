# ==============================================================================
# LangGraph Multi-Agent Research Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: mistral (default), gemini, groq, or mock (runs offline without API key)
LLM_PROVIDER=mistral

# Google Gemini Configuration
# Get your API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq Configuration (Optional, if LLM_PROVIDER=groq)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral Configuration (Active)
# Get your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b

# Retrieval Configuration
MAX_RETRIES=2

# MCP Server Custom Command Overrides (Optional)
# By default, the application runs the included FastMCP DuckDuckGo & Wikipedia
# servers via Python stdio without requiring external package installations.
# If you prefer external servers, uncomment and adjust the commands below:
# DUCKDUCKGO_MCP_COMMAND=uvx
# DUCKDUCKGO_MCP_ARGS=duckduckgo-mcp-server
# WIKIPEDIA_MCP_COMMAND=npx
# WIKIPEDIA_MCP_ARGS=-y wikipedia-mcp
